# Edge Functions — secrets de OTP
# Copia los valores reales en Supabase -> Settings -> Edge Functions -> Secrets
# (NO commitear valores reales). Para dev local: cp .env.example .env

# --- WhatsApp / Meta (transporte PRIMARIO de OTP) ---
WHATSAPP_ACCESS_TOKEN=         # token permanente de System User en Meta Business
WHATSAPP_PHONE_NUMBER_ID=      # ID del numero (no el numero en si)
WHATSAPP_TEMPLATE_NAME=ziteoo_otp  # plantilla aprobada en Meta, idioma es, body con {{1}}

# --- Twilio SMS (FALLBACK automatico si Meta falla) ---
# Si estas variables NO estan, el fallback no aplica y solo se usa WhatsApp.
TWILIO_ACCOUNT_SID=            # Account SID del panel Twilio (empieza con AC...)
TWILIO_AUTH_TOKEN=            # Auth Token del panel Twilio
# Define UNO de estos dos como remitente:
TWILIO_MESSAGING_SERVICE_SID= # Messaging Service SID (empieza con MG...), recomendado
TWILIO_FROM_NUMBER=          # alternativa: numero Twilio en formato E.164, ej +1234567890

# --- Dev only ---
# DEBUG_OTP_ENABLED=true       # devuelve debug_otp SOLO a origins localhost (staging)
