# Supabase (obtener en: https://supabase.com/dashboard/project/<project_id>/settings/api)
VITE_SUPABASE_URL=https://<project_id>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_key>

# Sentry (obtener en: https://sentry.io > Settings > Projects > <project> > Client Keys)
# Dejar en blanco en local para deshabilitar Sentry durante desarrollo
VITE_SENTRY_DSN=

# Solo backend / Edge Functions (NO exponer en frontend)
# SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Web Push / VAPID (generar con: node scripts/generate-vapid-keys.mjs)
# Solo la clave publica va aqui. La privada va en Supabase secrets como VAPID_PRIVATE_KEY (nunca al repo).
VITE_VAPID_PUBLIC_KEY=

# PostHog analytics (obtener en: https://app.posthog.com → Project Settings → API Keys)
# Dejar en blanco para deshabilitar analytics durante desarrollo
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Beta mode — muestra un formulario de registro simplificado en lugar del flujo OTP completo
# Cambiar a false o eliminar para restaurar el flujo normal
VITE_BETA_MODE=true

# Microsoft Clarity — heatmaps y session recordings
VITE_CLARITY_ID=

# Google Analytics 4 — conversiones y audiencias
VITE_GA4_ID=
